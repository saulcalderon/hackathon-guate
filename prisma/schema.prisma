generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String     @id @default(cuid())
  name      String
  status    String     @default("draft")
  materials Material[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Material {
  id        String        @id @default(cuid())
  name      String
  quantity  Float
  unit      String
  projectId String
  project   Project       @relation(fields: [projectId], references: [id])
  quotes    VendorQuote[]
}

model VendorQuote {
  id           String   @id @default(cuid())
  vendorName   String
  materialId   String
  material     Material @relation(fields: [materialId], references: [id])
  unitPrice    Float
  totalPrice   Float
  currency     String   @default("GTQ")
  source       String
  status       String   @default("live")
  brand        String?
  deliveryTime String?
  createdAt    DateTime @default(now())
}

model ScrapeCache {
  id         String   @id @default(cuid())
  searchTerm String
  vendor     String
  searchUrl  String
  products   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([searchTerm, vendor])
}

model SesionSolicitud {
  id                String   @id @default(uuid())
  descripcion       String
  categorias        String[] @default([])
  modo              String
  urgencia          String
  prioridades       String[] @default([])
  presupuesto       String?
  cantidad          Decimal? @db.Decimal(12, 4)
  unidad            String?
  resultados        Json     @default("[]")
  mensajes          Json     @default("[]")
  proveedorElegido  String?  @map("proveedor_elegido")
  estado            String   @default("activa")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  ordenes OrdenCompra[]

  @@index([createdAt(sort: Desc)])
  @@index([estado])
  @@map("sesiones_solicitud")
}

model OrdenCompra {
  id                   String   @id @default(uuid())
  sesionId             String?  @map("sesion_id")
  proveedorNombre      String   @map("proveedor_nombre")
  proveedorDisplay     String   @map("proveedor_display")
  descripcionProducto  String   @map("descripcion_producto")
  cantidad             String
  precioEstimado       Decimal  @map("precio_estimado") @db.Decimal(12, 2)
  moneda               String   @default("GTQ")
  comisionPct          Decimal  @default(8) @map("comision_pct") @db.Decimal(5, 2)
  totalConComision     Decimal  @map("total_con_comision") @db.Decimal(12, 2)
  notasCliente        String?  @map("notas_cliente")
  estado               String   @default("pendiente")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  sesion SesionSolicitud? @relation(fields: [sesionId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([estado])
  @@index([sesionId])
  @@map("ordenes_compra")
}
